# Name packages by linkage so shared and static SDK artifacts stay explicit.
if(BUILD_SHARED_LIBS)
    set(GGPO_PACKAGE_LINKAGE "shared")
    set(GGPO_PACKAGE_CONFLICT "ggpo-sdk-static")
else()
    set(GGPO_PACKAGE_LINKAGE "static")
    set(GGPO_PACKAGE_CONFLICT "ggpo-sdk-shared")
endif()

set(CPACK_PACKAGE_NAME "ggpo-sdk-${GGPO_PACKAGE_LINKAGE}")
set(CPACK_PACKAGE_VENDOR "GGPO contributors")
set(CPACK_PACKAGE_CONTACT "GGPO contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "GGPO rollback networking SDK (${GGPO_PACKAGE_LINKAGE})")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "ggpo-${PROJECT_VERSION}-linux-x86_64-${GGPO_PACKAGE_LINKAGE}")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")

set(CPACK_DEBIAN_PACKAGE_NAME "ggpo-sdk-${GGPO_PACKAGE_LINKAGE}")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "amd64")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "GGPO contributors")
set(CPACK_DEBIAN_PACKAGE_CONFLICTS "${GGPO_PACKAGE_CONFLICT}")
set(CPACK_DEBIAN_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}.deb")

set(CPACK_RPM_PACKAGE_NAME "ggpo-sdk-${GGPO_PACKAGE_LINKAGE}")
set(CPACK_RPM_PACKAGE_ARCHITECTURE "x86_64")
set(CPACK_RPM_PACKAGE_LICENSE "MIT")
set(CPACK_RPM_PACKAGE_GROUP "Development/Libraries")
set(CPACK_RPM_PACKAGE_CONFLICTS "${GGPO_PACKAGE_CONFLICT}")
set(CPACK_RPM_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}.rpm")

set(CPACK_GENERATOR "DEB;RPM")
include(CPack)
