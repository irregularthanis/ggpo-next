# One package carries every built flavor.  A dual build produces "ggpo-sdk",
# which replaces the 0.3.0-and-earlier per-linkage packages; single-flavor
# builds keep the historical "ggpo-sdk-shared"/"ggpo-sdk-static" names.
if(GGPO_BUILD_SHARED AND GGPO_BUILD_STATIC)
    set(GGPO_PACKAGE_NAME "ggpo-sdk")
    set(GGPO_PACKAGE_SUFFIX "")
    set(GGPO_PACKAGE_SUMMARY "shared and static")
    set(GGPO_PACKAGE_CONFLICT "ggpo-sdk-shared, ggpo-sdk-static")
    # RPM expresses the upgrade with Obsoletes/Provides below instead.
    set(GGPO_PACKAGE_RPM_CONFLICT "")
elseif(GGPO_BUILD_SHARED)
    set(GGPO_PACKAGE_NAME "ggpo-sdk-shared")
    set(GGPO_PACKAGE_SUFFIX "-shared")
    set(GGPO_PACKAGE_SUMMARY "shared")
    set(GGPO_PACKAGE_CONFLICT "ggpo-sdk, ggpo-sdk-static")
    set(GGPO_PACKAGE_RPM_CONFLICT "ggpo-sdk ggpo-sdk-static")
else()
    set(GGPO_PACKAGE_NAME "ggpo-sdk-static")
    set(GGPO_PACKAGE_SUFFIX "-static")
    set(GGPO_PACKAGE_SUMMARY "static")
    set(GGPO_PACKAGE_CONFLICT "ggpo-sdk, ggpo-sdk-shared")
    set(GGPO_PACKAGE_RPM_CONFLICT "ggpo-sdk ggpo-sdk-shared")
endif()

set(CPACK_PACKAGE_NAME "${GGPO_PACKAGE_NAME}")
set(CPACK_PACKAGE_VENDOR "GGPO contributors")
set(CPACK_PACKAGE_CONTACT "GGPO contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "GGPO rollback networking SDK (${GGPO_PACKAGE_SUMMARY})")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "ggpo-${PROJECT_VERSION}-linux-x86_64${GGPO_PACKAGE_SUFFIX}")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")

set(CPACK_DEBIAN_PACKAGE_NAME "${GGPO_PACKAGE_NAME}")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "amd64")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "GGPO contributors")
set(CPACK_DEBIAN_PACKAGE_CONFLICTS "${GGPO_PACKAGE_CONFLICT}")
if(GGPO_PACKAGE_NAME STREQUAL "ggpo-sdk")
    # Upgrading from either 0.3.0 package swaps it for the combined SDK.
    set(CPACK_DEBIAN_PACKAGE_REPLACES "ggpo-sdk-shared, ggpo-sdk-static")
    set(CPACK_DEBIAN_PACKAGE_PROVIDES "ggpo-sdk-shared, ggpo-sdk-static")
endif()
set(CPACK_DEBIAN_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}.deb")

set(CPACK_RPM_PACKAGE_NAME "${GGPO_PACKAGE_NAME}")
set(CPACK_RPM_PACKAGE_ARCHITECTURE "x86_64")
set(CPACK_RPM_PACKAGE_LICENSE "MIT")
set(CPACK_RPM_PACKAGE_GROUP "Development/Libraries")
set(CPACK_RPM_PACKAGE_CONFLICTS "${GGPO_PACKAGE_RPM_CONFLICT}")
if(GGPO_PACKAGE_NAME STREQUAL "ggpo-sdk")
    set(CPACK_RPM_PACKAGE_OBSOLETES "ggpo-sdk-shared ggpo-sdk-static")
    set(CPACK_RPM_PACKAGE_PROVIDES "ggpo-sdk-shared ggpo-sdk-static")
endif()
set(CPACK_RPM_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}.rpm")

set(CPACK_GENERATOR "DEB;RPM")
include(CPack)
